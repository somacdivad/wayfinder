{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayfinder.local/schemas/v1/inventory-request.schema.json",
  "title": "Wayfinder source inventory request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "selections", "targetRoots", "limits"],
  "properties": {
    "format": {"const": "wayfinder-source-inventory-request"},
    "schemaVersion": {"const": 1},
    "selections": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "targetRoots": {"type": "array", "items": {"type": "string"}},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxEntries", "maxFileBytes", "maxTotalBytes", "maxDepth"],
      "properties": {
        "maxEntries": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxFileBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxTotalBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "maxDepth": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    }
  }
}
