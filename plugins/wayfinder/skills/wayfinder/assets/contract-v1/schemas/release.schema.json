{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayfinder.local/schemas/v1/release.schema.json",
  "title": "Wayfinder contract release descriptor version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "releaseId", "status", "contractVersion", "contractManifest", "adapters", "certifications"],
  "properties": {
    "format": {"const": "wayfinder-contract-release"},
    "schemaVersion": {"const": 1},
    "releaseId": {"type": "string", "pattern": "^v1-candidate-revision-[1-9][0-9]*$"},
    "status": {"enum": ["unactivated-candidate", "unactivated-frozen", "activated-frozen"]},
    "contractVersion": {"const": 1},
    "contractManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"const": "assets/contract-v1/contract.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v1$"},
          "path": {"type": "string", "pattern": "^scripts/adapters/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:py|mjs|ps1)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "adapterSha256", "contractVersion", "contractSha256", "fixtureIndexSha256", "expectedOutputsSha256", "runtime", "operatingSystem", "filesystem", "locale", "timezone", "categories", "mutationCases", "interruptionBoundaries", "status", "resultsSha256", "certifiedAt", "expiryCondition"],
        "properties": {
          "adapterId": {"type": "string"},
          "adapterSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "contractVersion": {"const": 1},
          "contractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixtureIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expectedOutputsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation", "version"],
            "properties": {"implementation": {"type": "string"}, "version": {"type": "string"}}
          },
          "operatingSystem": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "version"],
            "properties": {"family": {"enum": ["macOS", "Linux", "Windows"]}, "version": {"type": "string"}}
          },
          "filesystem": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "caseSensitivity"],
            "properties": {"identity": {"type": "string"}, "caseSensitivity": {"enum": ["case-sensitive", "case-insensitive"]}}
          },
          "locale": {"type": "string"},
          "timezone": {"type": "string"},
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "count"],
              "properties": {"name": {"type": "string"}, "count": {"type": "integer", "minimum": 0}}
            }
          },
          "mutationCases": {"type": "array", "items": {"type": "string"}},
          "interruptionBoundaries": {"type": "array", "items": {"type": "string"}},
          "status": {"const": "passed"},
          "resultsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "certifiedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "expiryCondition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
